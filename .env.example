# ── Supabase (per-product project) ────────────────────────────────────────────
# Created by scripts/init-product.ts via Supabase Management API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Product identity (also lives in src/config/product.ts) ───────────────────
VITE_PRODUCT_SLUG=your-product-slug
VITE_PRODUCT_NAME=Your Product
VITE_PRODUCT_DOMAIN=yourproduct.com

# ── PostHog (SHARED studio project — same key across all products) ───────────
# Every product sends events with `product: VITE_PRODUCT_SLUG` super property
VITE_POSTHOG_KEY=phc_xxxxxxxx
VITE_POSTHOG_HOST=https://eu.posthog.com

# ── GrowthBook (SHARED studio instance) ──────────────────────────────────────
VITE_GROWTHBOOK_CLIENT_KEY=sdk-xxxxxxxx
VITE_GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# ── Supabase edge function secrets (set via `supabase secrets set`) ──────────
# These are NOT used by the Vite frontend — only by edge functions.
# Listed here so init-product.ts knows the full surface.

# Stripe (this product's standalone account — venture studio model)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic (AI features — used by ai-chat edge function)
# ANTHROPIC_API_KEY=sk-ant-...

# Studio integration (forwards orders/events to alaunchkit dashboard)
# STUDIO_WEBHOOK_URL=https://alaunchkit.vercel.app/api/webhook/order
# STUDIO_WEBHOOK_SECRET=shared-secret-from-alaunchkit
